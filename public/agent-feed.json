{
  "$schema": "https://json-schemas.org/draft/2020-12/schema",
  "version": "1.0.0",
  "name": "Kuro Footwear Store",
  "description": "Official Kuro Footwear store exposing agentic actions and interactive 3D micro-interfaces",
  "publisher": {
    "name": "Vibrisse Studio",
    "url": "https://www.vibrisse-studio.dev"
  },
  "tools": [
    {
      "name": "order_kuro_shoe",
      "description": "Configure the Kuro Runner V1 sneaker and prepare order for checkout",
      "ui": {
        "type": "web-component",
        "entrypoint": "/components/kuro-configurator.wc.js",
        "tag": "kuro-configurator",
        "height": "480px",
        "themeable": true
      },
      "parameters": {
        "type": "object",
        "properties": {
          "size": {
            "type": "number",
            "enum": [7, 8, 9, 10, 11],
            "description": "Standard US shoe size (US)"
          },
          "color": {
            "type": "string",
            "enum": ["Obsidian Black", "Deep Indigo", "Raw Chalk"],
            "description": "Official knit upper colorway"
          }
        },
        "required": ["size", "color"]
      },
      "handoff": {
        "type": "checkout-deep-link",
        "template": "/checkout?sku=KURO-V1-{color}-{size}&source=agent_feed",
        "description": "Pre-filled secure checkout redirect URL"
      }
    },
    {
      "name": "get_kuro_inventory",
      "description": "Query real-time stock levels for a specific SKU",
      "parameters": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Product SKU identifier (e.g. KURO-V1-Deep-Indigo-42)"
          }
        },
        "required": ["sku"]
      }
    }
  ]
}
